<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Who is ordering / booking: shared by the booking and checkout forms.
         Params: form (dict with member_ref, member_email) -->
    <template id="member_check_fields" name="Member verification fields">
        <details class="club-member-box" t-att-open="'open' if form['member_ref'] else None">
            <summary>I am a member (use my member price)</summary>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label" for="mem-ref">Member ID</label>
                    <input id="mem-ref" type="text" name="member_ref" class="form-control" placeholder="CC-00001"
                           maxlength="20" t-att-value="form['member_ref']"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="mem-email">E-mail on your membership</label>
                    <input id="mem-email" type="email" name="member_email" class="form-control" t-att-value="form['member_email']"/>
                </div>
                <div class="col-12 form-text">We check the ID and e-mail together. Leave this closed to continue as a guest.</div>
            </div>
        </details>
    </template>

    <!-- ============================ COURT BOOKING ============================ -->
    <template id="book_page" name="Book a court">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'club_book'"/>
            <div id="wrap" class="club-site club-book">
                <t t-call="club_website.page_header">
                    <t t-set="eyebrow" t-value="'Book a court'"/>
                    <t t-set="title" t-value="'Confirm your booking'"/>
                    <t t-set="subtitle" t-value="'Confirmed instantly. You pay at the club.'"/>
                </t>
                <section class="club-section">
                    <div class="container club-form-wrap">
                        <div class="alert alert-danger" role="alert" t-if="error" t-esc="error"/>
                        <t t-if="can_book">
                            <div class="club-summary">
                                <h3 t-esc="court.name"/>
                                <p class="club-muted"><t t-esc="when"/> · <strong><t t-esc="start_label"/> to <t t-esc="end_label"/></strong> (1 hour)</p>
                                <p>Guest price <strong>₹<t t-esc="'{:,.0f}'.format(court.list_price)"/></strong>.
                                   Members pay their tier rate: enter your member ID below.</p>
                                <p class="club-note" t-if="is_social">Friday is social play: several players share the court, so tell us how many are coming.</p>
                            </div>
                            <form action="/book/submit" method="post" class="club-form" novalidate="novalidate">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="court_id" t-att-value="court.id"/>
                                <input type="hidden" name="date" t-att-value="book_date"/>
                                <input type="hidden" name="time" t-att-value="book_time"/>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label" for="bk-name">Your name *</label>
                                        <input id="bk-name" type="text" name="name" class="form-control" maxlength="100"
                                               t-att-value="form['name']"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="bk-phone">Phone</label>
                                        <input id="bk-phone" type="tel" name="phone" class="form-control" maxlength="30"
                                               t-att-value="form['phone']"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="bk-email">E-mail (for your confirmation)</label>
                                        <input id="bk-email" type="email" name="email" class="form-control" t-att-value="form['email']"/>
                                    </div>
                                    <div class="col-md-6" t-if="is_social">
                                        <label class="form-label" for="bk-players">Players</label>
                                        <input id="bk-players" type="number" name="players" min="1" max="20" class="form-control"
                                               t-att-value="form['players']"/>
                                    </div>
                                    <div class="col-12"><t t-call="club_website.member_check_fields"/></div>
                                    <div class="club-hp" aria-hidden="true">
                                        <label for="bk-website">Leave this empty</label>
                                        <input id="bk-website" type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-club-primary btn-lg">Confirm booking</button>
                                        <a href="/courts" class="btn btn-link">Choose another slot</a>
                                    </div>
                                </div>
                            </form>
                        </t>
                        <t t-else="">
                            <p><a href="/courts" class="btn btn-club-primary">Back to court availability</a></p>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="booking_page" name="Your booking">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'club_booking'"/>
            <div id="wrap" class="club-site club-book">
                <section class="club-section">
                    <div class="container club-form-wrap text-center club-success">
                        <t t-if="booking.state in ('confirmed', 'draft', 'done')">
                            <div class="club-check" t-if="new">✓</div>
                            <h1 t-if="new">You are booked!</h1>
                            <h1 t-else="">Your booking</h1>
                        </t>
                        <t t-else="">
                            <h1>Booking cancelled</h1>
                        </t>
                        <div class="alert alert-info" t-if="flash" t-esc="flash"/>
                        <div class="club-summary text-start">
                            <p>Reference <strong class="club-ref" t-esc="booking.name"/></p>
                            <p><strong t-esc="booking.court_id.name"/><br/>
                               <t t-esc="when"/>, <t t-esc="start_label"/> to <t t-esc="end_label"/></p>
                            <p>Booked for <strong t-esc="customer"/></p>
                            <p>Price <strong>₹<t t-esc="'{:,.0f}'.format(booking.price)"/></strong>
                               <span class="club-muted"> (<t t-if="booking.tier == 'guest'">guest rate</t><t t-else=""><t t-esc="booking.tier.title()"/> member rate</t>, pay at the club)</span></p>
                            <p>Status <strong class="club-stock" t-esc="dict(booking._fields['state'].selection)[booking.state]"/></p>
                        </div>
                        <t t-if="can_cancel">
                            <form t-attf-action="/booking/#{booking.access_token}/cancel" method="post" class="mt-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-club-outline"
                                        onclick="return confirm('Cancel this booking?');">Cancel this booking</button>
                            </form>
                        </t>
                        <p class="club-muted mt-3">Keep this page: the link is private to you.</p>
                        <p><a href="/courts">Book another court</a> · <a href="/membership">See memberships</a></p>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ================================ SHOP ================================= -->
    <template id="cart_page" name="Your cart">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'club_cart'"/>
            <div id="wrap" class="club-site club-shop club-cart">
                <t t-call="club_website.page_header">
                    <t t-set="eyebrow" t-value="'Pro-Shop'"/>
                    <t t-set="title" t-value="'Your cart'"/>
                </t>
                <section class="club-section">
                    <div class="container">
                        <div class="alert alert-info" t-if="flash" t-esc="flash"/>
                        <t t-if="lines">
                            <form action="/club-shop/cart/update" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="table-responsive">
                                    <table class="table club-compare align-middle">
                                        <thead><tr><th>Product</th><th>Price</th><th style="width:7rem">Qty</th><th class="text-end">Total</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="lines" t-as="line">
                                                <td>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="club-thumb"><t t-set="product" t-value="line['product']"/><t t-call="club_website.product_image"/></div>
                                                        <div>
                                                    <a t-attf-href="/club-shop/#{line['product']['id']}" t-esc="line['product']['name']"/>
                                                    <div class="club-muted small" t-esc="site.stock_label(line['product']['stock'])"/>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>₹<t t-esc="'{:,.0f}'.format(line['product']['price'])"/></td>
                                                <td><input type="number" min="0" t-att-max="min(line['product']['stock'], 20)"
                                                           t-attf-name="qty_#{line['product']['id']}" t-att-value="line['qty']"
                                                           class="form-control club-qty" aria-label="Quantity"/></td>
                                                <td class="text-end">₹<t t-esc="'{:,.0f}'.format(line['total'])"/></td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr><th colspan="3" class="text-end">Subtotal</th>
                                                <th class="text-end">₹<t t-esc="'{:,.0f}'.format(subtotal)"/></th></tr>
                                        </tfoot>
                                    </table>
                                </div>
                                <p class="club-muted">Set a quantity to 0 to remove an item. Members get their discount at checkout.</p>
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="submit" class="btn btn-club-outline">Update cart</button>
                                    <a href="/club-shop" class="btn btn-link">Continue shopping</a>
                                    <a href="/club-shop/checkout" class="btn btn-club-primary btn-lg ms-auto">Checkout</a>
                                </div>
                            </form>
                        </t>
                        <t t-else="">
                            <p class="text-center py-5 club-muted">Your cart is empty. <a href="/club-shop">Browse the shop</a></p>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="checkout_page" name="Checkout">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'club_checkout'"/>
            <div id="wrap" class="club-site club-shop club-cart">
                <t t-call="club_website.page_header">
                    <t t-set="eyebrow" t-value="'Pro-Shop'"/>
                    <t t-set="title" t-value="'Checkout'"/>
                    <t t-set="subtitle" t-value="'You pay at the club when you collect, or on delivery.'"/>
                </t>
                <section class="club-section">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-lg-7">
                                <div class="alert alert-danger" role="alert" t-if="error" t-esc="error"/>
                                <form action="/club-shop/checkout/submit" method="post" class="club-form" novalidate="novalidate">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="co-name">Your name *</label>
                                            <input id="co-name" type="text" name="name" class="form-control" maxlength="100" t-att-value="form['name']"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="co-phone">Phone</label>
                                            <input id="co-phone" type="tel" name="phone" class="form-control" maxlength="30" t-att-value="form['phone']"/>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="co-email">E-mail (for your confirmation)</label>
                                            <input id="co-email" type="email" name="email" class="form-control" t-att-value="form['email']"/>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label d-block">How do you want it?</label>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="fulfillment" id="co-collect" value="collect"
                                                       t-att-checked="'checked' if form['fulfillment'] != 'delivery' else None"/>
                                                <label class="form-check-label" for="co-collect">Collect at the club</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="fulfillment" id="co-delivery" value="delivery"
                                                       t-att-checked="'checked' if form['fulfillment'] == 'delivery' else None"/>
                                                <label class="form-check-label" for="co-delivery">Home delivery</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="co-address">Delivery address (for delivery)</label>
                                            <textarea id="co-address" name="address" rows="2" class="form-control" maxlength="300" t-esc="form['address']"/>
                                        </div>
                                        <div class="col-12"><t t-call="club_website.member_check_fields"/></div>
                                        <div class="club-hp" aria-hidden="true">
                                            <label for="co-website">Leave this empty</label>
                                            <input id="co-website" type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-club-primary btn-lg">Place order</button>
                                            <a href="/club-shop/cart" class="btn btn-link">Back to the cart</a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="col-lg-5">
                                <div class="club-summary">
                                    <h4>Your order</h4>
                                    <ul class="list-unstyled">
                                        <li t-foreach="lines" t-as="line" class="d-flex justify-content-between">
                                            <span><t t-esc="line['product']['name']"/> × <t t-esc="line['qty']"/></span>
                                            <span>₹<t t-esc="'{:,.0f}'.format(line['total'])"/></span>
                                        </li>
                                    </ul>
                                    <hr/>
                                    <p class="d-flex justify-content-between"><strong>Subtotal</strong>
                                        <strong>₹<t t-esc="'{:,.0f}'.format(subtotal)"/></strong></p>
                                    <p class="club-muted small">Your member discount, if you are a member, is applied when you place the order.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="order_page" name="Your order">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'club_order'"/>
            <div id="wrap" class="club-site club-shop club-cart">
                <section class="club-section">
                    <div class="container club-form-wrap text-center club-success">
                        <div class="club-check">✓</div>
                        <h1>Thank you<t t-if="order.customer_name">, <t t-esc="order.customer_name"/></t>!</h1>
                        <p>Your order <strong class="club-ref" t-esc="order.name"/> is confirmed.</p>
                        <div class="club-summary text-start">
                            <table class="table club-compare">
                                <tbody>
                                    <tr t-foreach="order.line_ids" t-as="line">
                                        <td><t t-esc="line.product_id.name"/> × <t t-esc="line.qty"/></td>
                                        <td class="text-end">₹<t t-esc="'{:,.0f}'.format(line.line_total)"/></td>
                                    </tr>
                                    <tr t-if="order.discount">
                                        <td>Member discount (<t t-esc="order.plan_id.name"/>)</td>
                                        <td class="text-end">-₹<t t-esc="'{:,.0f}'.format(order.discount)"/></td>
                                    </tr>
                                    <tr><th>Total to pay</th><th class="text-end">₹<t t-esc="'{:,.0f}'.format(order.total)"/></th></tr>
                                </tbody>
                            </table>
                            <p><strong t-esc="order.fulfillment"/><t t-if="order.delivery_address"> to <t t-esc="order.delivery_address"/></t>.
                               Pay at the club or on delivery.</p>
                        </div>
                        <p class="club-muted mt-3">Keep this page: the link is private to you.</p>
                        <p><a href="/club-shop">Continue shopping</a> · <a href="/courts">Book a court</a></p>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
