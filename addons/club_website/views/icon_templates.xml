<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Line icons for the site (one stroke style, they take the text colour).
         Use: <t t-call="club_website.icon"><t t-set="name" t-value="'tennis'"/></t>
         Optional: size (pixels, default 28). Names: tennis, padel, badminton, cricket,
         shop, cafe, box, user, calendar, login. -->
    <template id="icon" name="Club icon">
        <svg class="club-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
             t-att-width="size or 28" t-att-height="size or 28" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <t t-if="name == 'tennis'">
                <ellipse cx="9.2" cy="9.2" rx="5" ry="6.8" transform="rotate(-45 9.2 9.2)"/>
                <path d="M12.800 12.800 L19 19"/>
                <path d="M18.200 21.200 L21.200 18.200"/>
                <path d="M6 9.500 L9.500 6 M8.200 12.200 L12.200 8.200"/>
            </t>
            <t t-elif="name == 'padel'">
                <path d="M12 2.500c3.500 0 6 2.300 6 5.800 0 2.900-1.800 5-4.200 6V16h-3.600v-1.700C7.800 13.300 6 11.200 6 8.300 6 4.800 8.500 2.500 12 2.500z"/>
                <rect x="10.500" y="16" width="3" height="5.500" rx="1"/>
                <circle cx="10" cy="6.500" r=".6" fill="currentColor"/>
                <circle cx="14" cy="6.500" r=".6" fill="currentColor"/>
                <circle cx="12" cy="9" r=".6" fill="currentColor"/>
                <circle cx="9.500" cy="10" r=".6" fill="currentColor"/>
                <circle cx="14.500" cy="10" r=".6" fill="currentColor"/>
            </t>
            <t t-elif="name == 'badminton'">
                <circle cx="12" cy="19.500" r="2.200"/>
                <path d="M10.400 17.600 L6.200 4 M13.600 17.600 L17.800 4 M12 17.300 V4"/>
                <path d="M5.600 4c3.900-1.400 9-1.400 12.800 0"/>
                <path d="M7.800 10.500 h8.400"/>
            </t>
            <t t-elif="name == 'cricket'">
                <rect x="7" y="9" width="5" height="11" rx="1.600" transform="rotate(45 9.500 14.500)"/>
                <path d="M13.400 10.600 L19.500 4.500"/>
                <path d="M18 3 L21 6"/>
                <circle cx="19" cy="19" r="2"/>
            </t>
            <t t-elif="name == 'shop'">
                <path d="M6 2L3 6v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </t>
            <t t-elif="name == 'cafe'">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/>
                <path d="M6 2v2 M10 2v2 M14 2v2"/>
            </t>
            <t t-elif="name == 'box'">
                <path d="M21 8l-9-5-9 5v8l9 5 9-5z"/>
                <path d="M3.300 7.500L12 12.500l8.700-5 M12 22.500v-10"/>
            </t>
            <t t-elif="name == 'user'">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </t>
            <t t-elif="name == 'calendar'">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <path d="M16 2v4 M8 2v4 M3 10h18"/>
            </t>
            <t t-elif="name == 'login'">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <path d="M10 17l5-5-5-5 M15 12H3"/>
            </t>
        </svg>
    </template>
</odoo>
