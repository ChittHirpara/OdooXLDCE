<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Pipeline: NEW > CONTACTED > INTERESTED > QUOTE SENT > NEGOTIATION > WON (and LOST).
         The first three reuse Odoo's stock stages so no lead is orphaned; Odoo's "lost"
         is an archived lead with a lost reason, not a stage. -->
    <record id="crm.stage_lead1" model="crm.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
    </record>
    <record id="crm.stage_lead2" model="crm.stage">
        <field name="name">Contacted</field>
        <field name="sequence">2</field>
    </record>
    <record id="crm.stage_lead3" model="crm.stage">
        <field name="name">Interested</field>
        <field name="sequence">3</field>
    </record>
    <record id="stage_quote_sent" model="crm.stage">
        <field name="name">Quote Sent</field>
        <field name="sequence">4</field>
    </record>
    <record id="stage_negotiation" model="crm.stage">
        <field name="name">Negotiation</field>
        <field name="sequence">5</field>
    </record>
    <record id="crm.stage_lead4" model="crm.stage">
        <field name="name">Won</field>
        <field name="is_won" eval="True"/>
        <field name="sequence">70</field>
    </record>

    <!-- Lost reasons -->
    <record id="lost_not_interested" model="crm.lost.reason">
        <field name="name">Not interested any more</field>
    </record>
    <record id="lost_no_response" model="crm.lost.reason">
        <field name="name">No response</field>
    </record>
    <record id="lost_competitor" model="crm.lost.reason">
        <field name="name">Joined another club</field>
    </record>
    <record id="lost_wrong_fit" model="crm.lost.reason">
        <field name="name">Plan or location does not fit</field>
    </record>

    <!-- Where enquiries come from (Odoo's marketing source) -->
    <record id="utm_source_website" model="utm.source">
        <field name="name">Club Website</field>
    </record>
</odoo>
