<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- No-discount pricelist for everyone who is not an active member. It sorts first so
         that Odoo's "first pricelist" fallback never hands a tier discount to non-members. -->
    <record id="pricelist_standard" model="product.pricelist">
        <field name="name">Club Standard (no discount)</field>
        <field name="sequence">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
