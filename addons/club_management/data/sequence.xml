<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_club_member" model="ir.sequence">
        <field name="name">Club Member ID</field>
        <field name="code">club.member</field>
        <field name="prefix">CC-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_club_booking" model="ir.sequence">
        <field name="name">Club Booking</field>
        <field name="code">club.booking</field>
        <field name="prefix">BK/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_club_enquiry" model="ir.sequence">
        <field name="name">Club Enquiry</field>
        <field name="code">club.enquiry</field>
        <field name="prefix">ENQ-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_club_order" model="ir.sequence">
        <field name="name">Club Order</field>
        <field name="code">club.order</field>
        <field name="prefix">ORD/</field>
        <field name="padding">5</field>
    </record>
</odoo>
