<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_lapse_memberships" model="ir.cron">
        <field name="name">Club: lapse expired memberships</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_lapse_memberships()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_membership_expiry_reminders" model="ir.cron">
        <field name="name">Club: membership expiry reminders</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_expiry_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="ir_cron_booking_reminders" model="ir.cron">
        <field name="name">Club: court booking reminders (day before)</field>
        <field name="model_id" ref="model_club_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_booking_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_low_stock_alert" model="ir.cron">
        <field name="name">Club: low stock alert to managers</field>
        <field name="model_id" ref="model_club_dashboard"/>
        <field name="state">code</field>
        <field name="code">model._cron_low_stock_alert()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>
