<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_order_tree" model="ir.ui.view">
        <field name="name">club.order.tree</field>
        <field name="model">club.order</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="name"/>
                <field name="create_date" string="Date"/>
                <field name="channel"/>
                <field name="customer_name"/>
                <field name="source" optional="show"/>
                <field name="plan_id"/>
                <field name="table_id" optional="hide"/>
                <field name="payment_method" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="subtotal" optional="hide"/>
                <field name="discount" sum="Discounts"/>
                <field name="total" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_club_order_form" model="ir.ui.view">
        <field name="name">club.order.form</field>
        <field name="model">club.order</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="channel"/>
                            <field name="customer_name"/>
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                        </group>
                        <group>
                            <field name="table_id" invisible="channel != 'bar'"/>
                            <field name="payment_method" invisible="channel != 'bar'"/>
                            <field name="fulfillment" invisible="channel != 'shop'"/>
                            <field name="customer_phone" invisible="not customer_phone"/>
                            <field name="customer_email" invisible="not customer_email"/>
                            <field name="source"/>
                            <field name="delivery_address" invisible="channel != 'shop'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="list_price"/>
                            <field name="unit_price"/>
                            <field name="line_total" sum="Total"/>
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="subtotal"/>
                        <field name="discount"/>
                        <field name="total" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_club_order_search" model="ir.ui.view">
        <field name="name">club.order.search</field>
        <field name="model">club.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_name"/>
                <filter name="bar" string="Bar &amp; Cafeteria" domain="[('channel', '=', 'bar')]"/>
                <filter name="shop" string="Pro-Shop" domain="[('channel', '=', 'shop')]"/>
                <filter name="from_website" string="Ordered Online" domain="[('source', '=', 'website')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="group_plan" string="Tier" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_club_order" model="ir.actions.act_window">
        <field name="name">Bar &amp; Shop Orders</field>
        <field name="res_model">club.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_club_orders" name="Bar &amp; Shop Orders" parent="menu_club_root"
              action="action_club_order" sequence="30"/>
</odoo>
