<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Gold -->
    <record id="demo_member_arjun" model="res.partner">
        <field name="name">Arjun Mehta</field>
        <field name="email">arjun.mehta@example.com</field>
        <field name="phone">+91 98100 00001</field>
        <field name="is_member" eval="True"/>
        <field name="plan_id" ref="plan_gold"/>
        <field name="join_date" eval="(datetime.now() - relativedelta(months=3)).strftime('%Y-%m-%d')"/>
        <field name="expiry_date" eval="(datetime.now() + relativedelta(months=9)).strftime('%Y-%m-%d')"/>
    </record>
