<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_booking_reschedule_form" model="ir.ui.view">
        <field name="name">club.booking.reschedule.form</field>
        <field name="model">club.booking.reschedule</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="booking_id" invisible="1"/>
                    <field name="current_start"/>
                    <field name="court_id"/>
                    <field name="new_start"/>
                </group>
                <footer>
                    <button name="action_reschedule" type="object" string="Reschedule"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
