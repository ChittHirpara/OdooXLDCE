<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="club_management.MembershipPlans">
        <div class="cc-membership-page-wrapper">
            <main class="cc-main-container">
                <!-- 2. Hero Section Component -->
                <section class="cc-hero">
                    <span class="cc-hero-pill">Memberships</span>
                    <h1 class="cc-hero-heading">Choose Your Membership</h1>
                    <p class="cc-hero-text">
                        Get access to the club, courts and member benefits with a plan that fits you.
                    </p>
                </section>

                <!-- 3. Membership Cards Grid (GOLD -> SILVER -> JUNIOR) -->
                <section class="cc-cards-grid">
                    <t t-foreach="state.plans" t-as="plan" t-key="plan.id">
                        <div t-att-class="'cc-card cc-card-' + plan.id + (state.selectedPlanId === plan.id ? ' selected' : '')"
                             t-on-click="() => this.selectPlan(plan.id)">
                            
                            <!-- Badges -->
                            <t t-if="plan.id === 'gold' and plan.badge">
                                <div class="cc-badge-popular"><t t-esc="plan.badge"/></div>
                            </t>
                            <t t-if="plan.id === 'junior' and plan.badge">
                                <div class="cc-badge-junior"><t t-esc="plan.badge"/></div>
                            </t>

                            <!-- Header -->
                            <div class="cc-card-header">
                                <h3 class="cc-tier-name"><t t-esc="plan.name"/></h3>
                                <p class="cc-tier-desc"><t t-esc="plan.description"/></p>
                            </div>

                            <!-- Price -->
                            <div class="cc-price-wrap">
                                <span class="cc-price-curr"><t t-esc="plan.currency"/></span>
                                <span class="cc-price-amount"><t t-esc="plan.price.toLocaleString('en-IN')"/></span>
                                <span class="cc-price-period">/ <t t-esc="plan.billing_period"/></span>
                            </div>

                            <!-- Benefits List Component -->
                            <ul class="cc-benefits-list">
                                <t t-foreach="plan.benefits" t-as="benefit" t-key="benefit">
                                    <li class="cc-benefit-item">
                                        <svg class="cc-check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><t t-esc="benefit"/></span>
                                    </li>
                                </t>
                            </ul>

                            <!-- Select Button -->
                            <button class="cc-btn-select" t-att-id="'btn-select-' + plan.id">
                                <t t-if="state.selectedPlanId === plan.id">
                                    <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                    <span>Selected</span>
                                </t>
                                <t t-else="">
                                    <span>Choose <t t-esc="plan.name.charAt(0) + plan.name.slice(1).toLowerCase()"/></span>
                                </t>
                            </button>
                        </div>
                    </t>
                </section>

                <t t-if="state.error">
                    <section class="cc-enrol"><p class="cc-enrol-error" t-esc="state.error"/></section>
                </t>
                <!-- Enrol at the desk -->
                <section class="cc-enrol" t-if="selectedPlan">
                    <h2 class="cc-enrol-title">Enrol at the desk</h2>
                    <p class="cc-enrol-sub">
                        Plan: <strong t-esc="selectedPlan.name"/> for <t t-esc="selectedPlan.currency"/><t t-esc="selectedPlan.price.toLocaleString('en-IN')"/>.
                        The invoice, member card, welcome e-mail and sign-in link are created for you.
                    </p>
                    <ClubMemberPicker t-key="state.formKey" label="'Enrolling'" guestLabel="'New person (not a member yet)'" guestHint="'Pick an existing member to renew, or enter the new person below.'" onChange.bind="onMemberChange"/>
                    <div class="cc-enrol-form" t-if="isNewPerson" t-key="state.formKey">
                        <input class="cc-enrol-input" placeholder="Full name" t-model="state.person.name"/>
                        <input class="cc-enrol-input" type="email" placeholder="E-mail" t-model="state.person.email"/>
                        <input class="cc-enrol-input" placeholder="Phone (optional)" t-model="state.person.phone"/>
                        <label class="cc-enrol-dob" t-if="selectedPlan.code === 'junior'">Date of birth
                            <input class="cc-enrol-input" type="date" t-model="state.person.dob"/>
                        </label>
                    </div>
                    <div class="cc-enrol-actions">
                        <select class="cc-enrol-input" t-model="state.method">
                            <option value="cash">Paid in cash</option>
                            <option value="card">Paid by card</option>
                            <option value="upi">Paid by UPI</option>
                        </select>
                        <button class="cc-enrol-btn" t-att-disabled="state.busy" t-on-click="enrol">
                            <i class="fa fa-check-circle"/> <t t-esc="state.busy ? 'Working...' : enrolLabel"/>
                        </button>
                    </div>
                    <p class="cc-enrol-done" t-if="state.done">
                        <i class="fa fa-check"/> <t t-esc="state.done.message"/> Invoice <t t-esc="state.done.invoice"/> is paid.
                    </p>
                </section>

                <!-- 4. Comparison Section Component -->

                <section class="cc-comparison-card">
                    <div class="cc-comparison-header">
                        <h2 class="cc-comparison-title">Membership Comparison</h2>
                        <p class="cc-comparison-subtitle">
                            Compare access privileges, court benefits, and club discounts across all tiers.
                        </p>
                    </div>

                    <div class="cc-table-wrapper">
                        <table class="cc-table">
                            <thead>
                                <tr>
                                    <th class="col-feature">Feature</th>
                                    <t t-foreach="state.plans" t-as="plan" t-key="plan.id">
                                        <th t-att-class="'col-' + plan.id + (state.selectedPlanId === plan.id ? ' selected-col' : '')"><t t-esc="plan.name.charAt(0) + plan.name.slice(1).toLowerCase()"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="comparisonRows" t-as="row" t-key="row.key">
                                    <tr>
                                        <td class="col-feature"><t t-esc="row.label"/></td>
                                        <t t-foreach="state.plans" t-as="plan" t-key="plan.id">
                                            <td t-att-class="'col-' + plan.id + ' col-val' + (plan.id === 'gold' ? ' highlight' : '') + (state.selectedPlanId === plan.id ? ' selected-col' : '')"><t t-esc="plan.features[row.key]"/></td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>

                        </table>
                    </div>
                </section>
            </main>
        </div>
    </t>
</templates>
