<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_club" model="ir.module.category">
        <field name="name">Club</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_club_staff" model="res.groups">
        <field name="name">Club Staff</field>
        <field name="category_id" ref="module_category_club"/>
        <!-- Billing for court/shop invoices; all CRM leads and quotations for follow-up -->
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('account.group_account_invoice')),
            (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_club_manager" model="res.groups">
        <field name="name">Club Manager</field>
        <field name="category_id" ref="module_category_club"/>
        <field name="implied_ids" eval="[(4, ref('group_club_staff')), (4, ref('sales_team.group_sale_manager')),
            (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('hr.group_hr_user')), (4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
