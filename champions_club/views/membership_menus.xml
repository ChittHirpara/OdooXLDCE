<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Root Menu -->
    <menuitem id="menu_champions_club_root"
              name="Champions Club"
              web_icon="champions_club,static/description/icon.png"
              sequence="10"/>

    <!-- 1. Memberships Parent Menu -->
    <menuitem id="menu_champions_membership"
              name="Memberships"
              parent="menu_champions_club_root"
              sequence="10"/>

    <record id="action_champions_membership_plans_owl" model="ir.actions.client">
        <field name="name">Membership Plans</field>
        <field name="tag">champions_club.membership_plans</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_champions_membership_plans_owl"
              name="Membership Plans (OWL)"
              parent="menu_champions_membership"
              action="action_champions_membership_plans_owl"
              sequence="10"/>

    <record id="action_champions_membership_plans_backend" model="ir.actions.act_window">
        <field name="name">Plan Configuration</field>
        <field name="res_model">champions.membership.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_champions_membership_plans_backend"
              name="Plan Settings"
              parent="menu_champions_membership"
              action="action_champions_membership_plans_backend"
              sequence="90"/>

    <!-- 2. Courts & Bookings Parent Menu -->
    <menuitem id="menu_champions_courts"
              name="Courts &amp; Bookings"
              parent="menu_champions_club_root"
              sequence="20"/>

    <record id="action_champions_court_booking_owl" model="ir.actions.client">
        <field name="name">Book a Court</field>
        <field name="tag">champions_club.court_booking</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_champions_court_booking_owl"
              name="Book a Court (OWL)"
              parent="menu_champions_courts"
              action="action_champions_court_booking_owl"
              sequence="10"/>

    <record id="action_club_courts_backend" model="ir.actions.act_window">
        <field name="name">Courts Directory</field>
        <field name="res_model">club.court</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_courts_backend"
              name="Manage Courts"
              parent="menu_champions_courts"
              action="action_club_courts_backend"
              sequence="30"/>

    <record id="action_club_bookings_backend" model="ir.actions.act_window">
        <field name="name">All Reservations</field>
        <field name="res_model">club.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_bookings_backend"
              name="All Bookings"
              parent="menu_champions_courts"
              action="action_club_bookings_backend"
              sequence="40"/>

    <!-- 3. Pro-Shop & eCommerce Parent Menu -->
    <menuitem id="menu_champions_shop"
              name="Pro-Shop"
              parent="menu_champions_club_root"
              sequence="30"/>

    <!-- Client Action for OWL Pro-Shop Interface -->
    <record id="action_champions_shop_owl" model="ir.actions.client">
        <field name="name">Pro-Shop &amp; Equipment</field>
        <field name="tag">champions_club.shop</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_champions_shop_owl"
              name="Pro-Shop (OWL)"
              parent="menu_champions_shop"
              action="action_champions_shop_owl"
              sequence="10"/>

    <record id="action_club_shop_products_backend" model="ir.actions.act_window">
        <field name="name">Product Inventory</field>
        <field name="res_model">club.shop.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_shop_products_backend"
              name="Inventory &amp; Pricing"
              parent="menu_champions_shop"
              action="action_club_shop_products_backend"
              sequence="20"/>

    <!-- 4. Bar & Cafeteria POS Parent Menu -->
    <menuitem id="menu_champions_pos"
              name="Bar &amp; POS"
              parent="menu_champions_club_root"
              sequence="40"/>

    <!-- Client Action for OWL Bar POS Interface -->
    <record id="action_champions_bar_pos_owl" model="ir.actions.client">
        <field name="name">Bar &amp; Cafeteria POS</field>
        <field name="tag">champions_club.bar_pos</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_champions_bar_pos_owl"
              name="Point of Sale (OWL)"
              parent="menu_champions_pos"
              action="action_champions_bar_pos_owl"
              sequence="10"/>

    <record id="action_club_pos_orders_backend" model="ir.actions.act_window">
        <field name="name">POS Orders</field>
        <field name="res_model">club.pos.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_pos_orders_backend"
              name="Order History"
              parent="menu_champions_pos"
              action="action_club_pos_orders_backend"
              sequence="20"/>

    <record id="action_club_pos_tables_backend" model="ir.actions.act_window">
        <field name="name">Tables Management</field>
        <field name="res_model">club.pos.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_pos_tables_backend"
              name="Tables &amp; Floor"
              parent="menu_champions_pos"
              action="action_club_pos_tables_backend"
              sequence="30"/>
</odoo>
