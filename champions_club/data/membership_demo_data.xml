<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. GOLD (Premium / Full Access) -->
        <record id="plan_gold" model="champions.membership.plan">
            <field name="name">GOLD</field>
            <field name="code">gold</field>
            <field name="sequence">1</field>
            <field name="badge_text">MOST POPULAR</field>
            <field name="description">Premium access for members who want the complete club experience.</field>
            <field name="price">5000.0</field>
            <field name="billing_period">year</field>
            <field name="club_access">Full club access (All facilities &amp; lounges)</field>
            <field name="court_benefits">Priority prime-time booking &amp; 7 days advance</field>
            <field name="shop_benefits">20% member discount on all gear</field>
            <field name="bar_benefits">15% discount at cafeteria &amp; sports bar</field>
            <field name="membership_type">Premium / Full Access VIP</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. SILVER (Standard) -->
        <record id="plan_silver" model="champions.membership.plan">
            <field name="name">SILVER</field>
            <field name="code">silver</field>
            <field name="sequence">2</field>
            <field name="badge_text"></field>
            <field name="description">Standard membership for regular club users.</field>
            <field name="price">3000.0</field>
            <field name="billing_period">year</field>
            <field name="club_access">Standard club access (Courts &amp; locker room)</field>
            <field name="court_benefits">Standard booking window (4 days advance)</field>
            <field name="shop_benefits">10% member discount on gear</field>
            <field name="bar_benefits">Standard member rates (No discount)</field>
            <field name="membership_type">Standard Adult Membership</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 3. JUNIOR (Under 18 / Discounted) -->
        <record id="plan_junior" model="champions.membership.plan">
            <field name="name">JUNIOR</field>
            <field name="code">junior</field>
            <field name="sequence">3</field>
            <field name="badge_text">UNDER 18</field>
            <field name="description">Discounted membership for members under 18.</field>
            <field name="price">1500.0</field>
            <field name="billing_period">year</field>
            <field name="club_access">Junior access (Academy &amp; off-peak hours)</field>
            <field name="court_benefits">Discounted court rates (Off-peak &amp; clinics)</field>
            <field name="shop_benefits">5% discount on junior equipment</field>
            <field name="bar_benefits">10% smoothie bar &amp; snacks discount</field>
            <field name="membership_type">Youth &amp; Academy (&lt; 18 yrs)</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
